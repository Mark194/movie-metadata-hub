# PostgreSQL
POSTGRES_DB=theatre
POSTGRES_USER=user
POSTGRES_PASSWORD=password

SQL_HOST=theatre-db
SQL_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=movies

ES_PORT=9200

BATCH_SIZE=1000
SLEEP_TIME=60
STORAGE_TYPE=json

JWT__SECRET_KEY=your-secret-key-here
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7